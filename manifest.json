{
    "manifest_version": 3,

    "name": "YouTube Speed Controls Mine",
    "description": "Press ` to increase playback speed, or ctrl+` to decrease. Supports 0.5x to 20x.",
    "version": "1.4",

    "content_scripts": [
        {
            "matches": [
              "https://*.youtube.com/*"
            ],
            "js": [
                "src/javascript/script.js"
            ],
            "css": [
                "src/css/styles.css"
            ]
        }
    ],

    "icons": {
        "16": "src/images/icon16.png",
        "48": "src/images/icon48.png",
        "128": "src/images/icon128.png"
    }
}
